# ==========================================
# POKKY OPTIMIZE SHOP - ENVIRONMENT SETTINGS
# ==========================================

# (Required) Supabase Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# (Required) Discord OAuth2 Authentication
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# (Required) Cryptographic Session & Admin Auth Secrets
ADMIN_SESSION_SECRET=your-random-64-character-admin-secret-key
ADMIN_PASSWORD=your-secure-admin-password
USER_SESSION_SECRET=your-random-64-character-user-session-secret-key

# (Optional) Google Gemini AI Assistant
GEMINI_API_KEY=your-gemini-api-key

